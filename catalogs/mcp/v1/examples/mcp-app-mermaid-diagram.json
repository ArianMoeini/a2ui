          {
            "id": "mermaid_heading",
            "component": "Text",
            "text": "### Mermaid Diagram Viewer & Live Editor (`finfin/mermaid-mcp-app` — `ontoolinput` + two-way node selection)"
          },
          {
            "id": "mermaid_app",
            "component": "McpApp",
            "title": "Mermaid Live Diagram Viewer",
            "htmlContent": "<!doctype html>\n<html>\n<head>\n<meta charset=\"utf-8\" />\n<style>\n\n* { box-sizing: border-box; }\nbody {\n  margin: 0;\n  font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n  background: #0f172a;\n  color: #e2e8f0;\n  height: 100vh;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n.topbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  padding: 8px 12px;\n  background: #1e293b;\n  border-bottom: 1px solid #334155;\n  flex-shrink: 0;\n  flex-wrap: wrap;\n}\n.topbar-left {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.app-badge {\n  font-size: 11px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  padding: 2px 7px;\n  border-radius: 999px;\n  background: rgba(56, 189, 248, 0.16);\n  color: #38bdf8;\n  border: 1px solid rgba(56, 189, 248, 0.3);\n}\n.app-title {\n  font-size: 13px;\n  font-weight: 600;\n  color: #f8fafc;\n}\n.topbar-right {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n.dims-pill {\n  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n  font-size: 11px;\n  padding: 2px 8px;\n  border-radius: 6px;\n  background: #0f172a;\n  color: #94a3b8;\n  border: 1px solid #334155;\n}\n.btn {\n  font-family: inherit;\n  font-size: 11px;\n  font-weight: 500;\n  padding: 4px 9px;\n  border-radius: 6px;\n  border: 1px solid #475569;\n  background: #1e293b;\n  color: #e2e8f0;\n  cursor: pointer;\n  transition: all 120ms ease;\n}\n.btn:hover { background: #334155; color: #fff; }\n.btn.active, .btn.primary {\n  background: #2563eb;\n  border-color: #3b82f6;\n  color: #fff;\n}\n.btn.primary:hover { background: #1d4ed8; }\n\n.workspace {\n  display: grid;\n  grid-template-columns: 240px 1fr;\n  flex: 1;\n  min-height: 0;\n}\n@media (max-width: 560px) {\n  .workspace { grid-template-columns: 1fr; grid-template-rows: 130px 1fr; }\n}\n.editor-pane {\n  display: flex;\n  flex-direction: column;\n  border-right: 1px solid #334155;\n  background: #0b1120;\n  min-height: 0;\n}\n.pane-label {\n  font-size: 11px;\n  font-weight: 600;\n  color: #94a3b8;\n  padding: 6px 10px;\n  border-bottom: 1px solid #1e293b;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\ntextarea {\n  flex: 1;\n  width: 100%;\n  background: transparent;\n  color: #38bdf8;\n  border: none;\n  padding: 10px;\n  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n  font-size: 12px;\n  line-height: 1.45;\n  resize: none;\n  outline: none;\n}\n.canvas-pane {\n  position: relative;\n  flex: 1;\n  background: radial-gradient(circle at center, #1e293b 1px, transparent 1px);\n  background-size: 18px 18px;\n  background-color: #0f172a;\n  overflow: hidden;\n  cursor: grab;\n  user-select: none;\n}\n.canvas-pane:active { cursor: grabbing; }\nsvg { width: 100%; height: 100%; display: block; }\n.node-rect {\n  fill: #1e293b;\n  stroke: #38bdf8;\n  stroke-width: 1.8;\n  rx: 8;\n  transition: fill 150ms, stroke 150ms;\n  cursor: pointer;\n}\n.node-group:hover .node-rect { fill: #1e3a8a; stroke: #60a5fa; }\n.node-group.selected .node-rect { fill: #1d4ed8; stroke: #facc15; stroke-width: 2.5; }\n.node-label {\n  fill: #f8fafc;\n  font-size: 12px;\n  font-weight: 600;\n  text-anchor: middle;\n  dominant-baseline: central;\n  pointer-events: none;\n}\n.edge-path {\n  fill: none;\n  stroke: #64748b;\n  stroke-width: 1.8;\n  marker-end: url(#arrow);\n}\n.edge-path.highlight { stroke: #facc15; stroke-width: 2.4; }\n.edge-label {\n  fill: #94a3b8;\n  font-size: 10px;\n  text-anchor: middle;\n}\n.hud {\n  position: absolute;\n  left: 10px;\n  bottom: 10px;\n  font-size: 11px;\n  background: rgba(15, 23, 42, 0.85);\n  border: 1px solid #334155;\n  padding: 4px 8px;\n  border-radius: 6px;\n  color: #cbd5e1;\n}\n</style>\n</head>\n<body>\n  <div class=\"topbar\">\n    <div class=\"topbar-left\">\n      <span class=\"app-badge\">MCP App 1</span>\n      <span class=\"app-title\">Mermaid Live Diagram Viewer</span>\n      <button class=\"btn\" id=\"preset-arch\">Microservices</button>\n      <button class=\"btn\" id=\"preset-auth\">OAuth Flow</button>\n      <button class=\"btn\" id=\"preset-agent\">Agent Loop</button>\n    </div>\n    <div class=\"topbar-right\">\n      <button class=\"btn\" id=\"zoom-in\" title=\"Zoom in\">+</button>\n      <button class=\"btn\" id=\"zoom-out\" title=\"Zoom out\">−</button>\n      <button class=\"btn\" id=\"zoom-reset\">Fit</button>\n      <button class=\"btn primary\" id=\"export-btn\">Export SVG</button>\n      <span class=\"dims-pill\" id=\"dims-badge\">auto</span>\n    </div>\n  </div>\n  <div class=\"workspace\">\n    <div class=\"editor-pane\">\n      <div class=\"pane-label\">\n        <span>MERMAID SOURCE</span>\n        <span id=\"edge-count\">0 edges</span>\n      </div>\n      <textarea id=\"code-input\" spellcheck=\"false\"></textarea>\n    </div>\n    <div class=\"canvas-pane\" id=\"canvas-pane\">\n      <svg id=\"diagram-svg\" viewBox=\"0 0 600 320\">\n        <defs>\n          <marker id=\"arrow\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto-start-reverse\">\n            <path d=\"M 0 1 L 10 5 L 0 9 z\" fill=\"#64748b\" />\n          </marker>\n        </defs>\n        <g id=\"viewport\"></g>\n      </svg>\n      <div class=\"hud\" id=\"hud\">Click any node to inspect • Drag to pan</div>\n    </div>\n  </div>\n<script>\n\nlet nextId = 1;\nconst pending = new Map();\nlet hostDims = { width: 0, height: 0 };\nconst toolInputListeners = [];\nconst toolResultListeners = [];\nconst dataUpdateListeners = [];\nconst hostContextListeners = [];\n\nfunction post(message) {\n  window.parent.postMessage(message, '*');\n}\n\nfunction sendRequest(method, params) {\n  const id = nextId++;\n  post({ jsonrpc: '2.0', id, method, params });\n  return new Promise((resolve, reject) => pending.set(id, { resolve, reject }));\n}\n\nfunction sendNotification(method, params = {}) {\n  post({ jsonrpc: '2.0', method, params });\n}\n\nfunction reportSize(height, width) {\n  const params = {};\n  if (typeof height === 'number') params.height = Math.round(height);\n  if (typeof width === 'number') params.width = Math.round(width);\n  sendNotification('ui/notifications/size-changed', params);\n}\n\nfunction updateDimsBadge(dims) {\n  if (!dims) return;\n  if (typeof dims.width === 'number') hostDims.width = Math.round(dims.width);\n  if (typeof dims.height === 'number') hostDims.height = Math.round(dims.height);\n  const el = document.getElementById('dims-badge');\n  if (el && hostDims.width && hostDims.height) {\n    el.textContent = hostDims.width + ' × ' + hostDims.height + ' px';\n  }\n}\n\nwindow.addEventListener('message', (event) => {\n  const msg = event.data;\n  if (!msg || msg.jsonrpc !== '2.0') return;\n  if (msg.method === 'ping' && msg.id !== undefined) {\n    post({ jsonrpc: '2.0', id: msg.id, result: {} });\n    return;\n  }\n  if (msg.id !== undefined && (msg.result !== undefined || msg.error !== undefined)) {\n    const waiter = pending.get(msg.id);\n    if (waiter) {\n      pending.delete(msg.id);\n      if (msg.error) waiter.reject(msg.error);\n      else waiter.resolve(msg.result);\n    }\n    return;\n  }\n  if (msg.method === 'ui/notifications/tool-input') {\n    const args = (msg.params && msg.params.arguments) || {};\n    toolInputListeners.forEach((fn) => fn(args));\n  } else if (msg.method === 'ui/notifications/tool-result') {\n    const res = msg.params || {};\n    toolResultListeners.forEach((fn) => fn(res));\n  } else if (msg.method === 'ui/notifications/data-model-update') {\n    dataUpdateListeners.forEach((fn) => fn(msg.params || {}));\n  } else if (msg.method === 'ui/notifications/host-context-changed') {\n    const ctx = msg.params || {};\n    if (ctx.containerDimensions) updateDimsBadge(ctx.containerDimensions);\n    hostContextListeners.forEach((fn) => fn(ctx));\n  }\n});\n\nasync function bootMcpApp(appName, initialHeight) {\n  const initResult = await sendRequest('ui/initialize', {\n    appInfo: { name: appName, version: '1.0.0' },\n    appCapabilities: { availableDisplayModes: ['inline', 'fullscreen'] },\n    protocolVersion: '2026-01-26',\n  });\n  if (initResult && initResult.hostContext && initResult.hostContext.containerDimensions) {\n    updateDimsBadge(initResult.hostContext.containerDimensions);\n  }\n  sendNotification('ui/notifications/initialized', {});\n  if (initialHeight) {\n    reportSize(initialHeight);\n  }\n}\n\n\nconst PRESETS = {\n  microservices: `graph TD\n  Client[Web Client] -->|HTTPS| Gateway[API Gateway]\n  Gateway -->|gRPC| Auth[Auth Service]\n  Gateway -->|gRPC| Orders[Order Engine]\n  Orders -->|SQL| DB[(Cloud Spanner)]\n  Orders -->|PubSub| Worker[Fulfillment Worker]`,\n  oauth: `graph TD\n  User[User Browser] -->|1. Login| App[MCP Host App]\n  App -->|2. Auth Code| IdP[OAuth Provider]\n  IdP -->|3. Access Token| App\n  App -->|4. Bearer Call| Resource[MCP Tool Server]`,\n  agent: `graph TD\n  Prompt[User Prompt] -->|Context| Planner[LLM Planner]\n  Planner -->|Tool Call| Sandbox[McpApp Sandbox]\n  Sandbox -->|Model Update| State[A2UI DataModel]\n  State -->|Reactive Sync| Planner`\n};\n\nlet currentCode = PRESETS.microservices;\nlet selectedNodeId = 'Gateway';\nlet zoom = 1;\nlet panX = 0;\nlet panY = 0;\n\nconst codeInput = document.getElementById('code-input');\nconst viewport = document.getElementById('viewport');\nconst edgeCountEl = document.getElementById('edge-count');\nconst hudEl = document.getElementById('hud');\n\nfunction parseMermaid(src) {\n  const nodes = new Map();\n  const edges = [];\n  const lines = String(src || '').split(/\\r?\\n/);\n  const edgeRe = /^\\s*([A-Za-z0-9_]+)(?:\\[([^\\]]+)\\]|\\(\\(([^)]+)\\)\\)|\\(\\[([^\\]]+)\\]\\))?\\s*-->\\s*(?:\\|([^|]+)\\|\\s*)?([A-Za-z0-9_]+)(?:\\[([^\\]]+)\\]|\\(\\(([^)]+)\\)\\)|\\(\\[([^\\]]+)\\]\\))?/;\n  for (const line of lines) {\n    const m = line.match(edgeRe);\n    if (!m) continue;\n    const fromId = m[1];\n    const fromLabel = m[2] || m[3] || m[4] || fromId;\n    const edgeLabel = m[5] || '';\n    const toId = m[6];\n    const toLabel = m[7] || m[8] || m[9] || toId;\n    if (!nodes.has(fromId)) nodes.set(fromId, { id: fromId, label: fromLabel });\n    else if (m[2] || m[3] || m[4]) nodes.get(fromId).label = fromLabel;\n    if (!nodes.has(toId)) nodes.set(toId, { id: toId, label: toLabel });\n    else if (m[7] || m[8] || m[9]) nodes.get(toId).label = toLabel;\n    edges.push({ from: fromId, to: toId, label: edgeLabel });\n  }\n  return { nodes: Array.from(nodes.values()), edges };\n}\n\nfunction layoutAndRender() {\n  const { nodes, edges } = parseMermaid(currentCode);\n  edgeCountEl.textContent = edges.length + ' edges';\n  viewport.textContent = '';\n  if (nodes.length === 0) return;\n\n  const indegree = new Map(nodes.map(n => [n.id, 0]));\n  const adj = new Map(nodes.map(n => [n.id, []]));\n  for (const e of edges) {\n    adj.get(e.from)?.push(e.to);\n    indegree.set(e.to, (indegree.get(e.to) || 0) + 1);\n  }\n  const depth = new Map();\n  const queue = nodes.filter(n => (indegree.get(n.id) || 0) === 0).map(n => n.id);\n  if (queue.length === 0) queue.push(nodes[0].id);\n  for (const id of queue) depth.set(id, 0);\n  while (queue.length > 0) {\n    const u = queue.shift();\n    const d = depth.get(u) || 0;\n    for (const v of (adj.get(u) || [])) {\n      if (!depth.has(v) || depth.get(v) < d + 1) {\n        depth.set(v, d + 1);\n        if (depth.get(v) < 6) queue.push(v);\n      }\n    }\n  }\n  const layers = new Map();\n  for (const n of nodes) {\n    const d = depth.get(n.id) ?? 0;\n    if (!layers.has(d)) layers.set(d, []);\n    layers.get(d).push(n);\n  }\n  const maxLayer = Math.max(... Array.from(layers.keys()), 0);\n  const pos = new Map();\n  for (const [d, group] of layers.entries()) {\n    const y = 52 + (maxLayer === 0 ? 110 : (d * 210) / Math.max(maxLayer, 1));\n    group.forEach((n, idx) => {\n      const x = ((idx + 1) * 600) / (group.length + 1);\n      pos.set(n.id, { x, y });\n    });\n  }\n\n  const ns = 'http://www.w3.org/2000/svg';\n  for (const e of edges) {\n    const p1 = pos.get(e.from);\n    const p2 = pos.get(e.to);\n    if (!p1 || !p2) continue;\n    const path = document.createElementNS(ns, 'path');\n    const midY = (p1.y + p2.y) / 2;\n    path.setAttribute('d', `M ${p1.x} ${p1.y + 18} C ${p1.x} ${midY}, ${p2.x} ${midY}, ${p2.x} ${p2.y - 20}`);\n    const isHi = e.from === selectedNodeId || e.to === selectedNodeId;\n    path.setAttribute('class', isHi ? 'edge-path highlight' : 'edge-path');\n    viewport.appendChild(path);\n    if (e.label) {\n      const lbl = document.createElementNS(ns, 'text');\n      lbl.setAttribute('x', String((p1.x + p2.x) / 2));\n      lbl.setAttribute('y', String(midY - 4));\n      lbl.setAttribute('class', 'edge-label');\n      lbl.textContent = e.label;\n      viewport.appendChild(lbl);\n    }\n  }\n\n  for (const n of nodes) {\n    const p = pos.get(n.id);\n    const g = document.createElementNS(ns, 'g');\n    g.setAttribute('class', n.id === selectedNodeId ? 'node-group selected' : 'node-group');\n    g.setAttribute('transform', `translate(${p.x - 62}, ${p.y - 18})`);\n    const rect = document.createElementNS(ns, 'rect');\n    rect.setAttribute('width', '124');\n    rect.setAttribute('height', '36');\n    rect.setAttribute('class', 'node-rect');\n    const txt = document.createElementNS(ns, 'text');\n    txt.setAttribute('x', '62');\n    txt.setAttribute('y', '18');\n    txt.setAttribute('class', 'node-label');\n    txt.textContent = n.label;\n    g.appendChild(rect);\n    g.appendChild(txt);\n    g.addEventListener('click', (ev) => {\n      ev.stopPropagation();\n      selectNode(n);\n    });\n    viewport.appendChild(g);\n  }\n  applyTransform();\n}\n\nfunction applyTransform() {\n  viewport.setAttribute('transform', `translate(${panX}, ${panY}) scale(${zoom})`);\n}\n\nfunction selectNode(node) {\n  selectedNodeId = node.id;\n  hudEl.textContent = `Selected: ${node.label} (${node.id})`;\n  layoutAndRender();\n  sendNotification('ui/notifications/data-model-change', {\n    key: 'mermaid',\n    subpath: '/selectedNode',\n    value: node.label,\n  });\n  sendRequest('ui/update-model-context', {\n    structuredContent: { selectedNode: node.label },\n  }).catch(() => {});\n}\n\nfunction applyMermaidState(data) {\n  if (!data || typeof data !== 'object') return;\n  if (typeof data.code === 'string' && data.code !== currentCode) {\n    currentCode = data.code;\n    codeInput.value = currentCode;\n  }\n  if (typeof data.selectedNode === 'string' && data.selectedNode !== selectedNodeId) {\n    selectedNodeId = data.selectedNode;\n  }\n  layoutAndRender();\n}\n\ncodeInput.value = currentCode;\ncodeInput.addEventListener('input', () => {\n  currentCode = codeInput.value;\n  layoutAndRender();\n  sendNotification('ui/notifications/data-model-change', {\n    key: 'mermaid',\n    subpath: '/code',\n    value: currentCode,\n  });\n});\n\ndocument.getElementById('preset-arch').addEventListener('click', () => {\n  currentCode = PRESETS.microservices;\n  codeInput.value = currentCode;\n  layoutAndRender();\n});\ndocument.getElementById('preset-auth').addEventListener('click', () => {\n  currentCode = PRESETS.oauth;\n  codeInput.value = currentCode;\n  layoutAndRender();\n});\ndocument.getElementById('preset-agent').addEventListener('click', () => {\n  currentCode = PRESETS.agent;\n  codeInput.value = currentCode;\n  layoutAndRender();\n});\ndocument.getElementById('zoom-in').addEventListener('click', () => { zoom = Math.min(2.2, zoom + 0.2); applyTransform(); });\ndocument.getElementById('zoom-out').addEventListener('click', () => { zoom = Math.max(0.5, zoom - 0.2); applyTransform(); });\ndocument.getElementById('zoom-reset').addEventListener('click', () => { zoom = 1; panX = 0; panY = 0; applyTransform(); });\ndocument.getElementById('export-btn').addEventListener('click', () => {\n  sendRequest('tools/call', {\n    name: 'export_mermaid_svg',\n    arguments: { selectedNode: selectedNodeId, codeLength: currentCode.length },\n  });\n  hudEl.textContent = `Exported SVG for node '${selectedNodeId}' via tools/call`;\n});\n\nlet dragging = false, startX = 0, startY = 0;\nconst canvasPane = document.getElementById('canvas-pane');\ncanvasPane.addEventListener('pointerdown', (e) => {\n  if (e.target.closest('.node-group')) return;\n  dragging = true; startX = e.clientX - panX; startY = e.clientY - panY;\n});\nwindow.addEventListener('pointermove', (e) => {\n  if (!dragging) return;\n  panX = e.clientX - startX; panY = e.clientY - startY; applyTransform();\n});\nwindow.addEventListener('pointerup', () => { dragging = false; });\n\ntoolInputListeners.push((args) => {\n  applyMermaidState(args.mermaid || args);\n});\ndataUpdateListeners.push((params) => {\n  if (params.key === 'mermaid') {\n    if (!params.subpath) applyMermaidState(params.value);\n    else if (params.subpath === '/code') applyMermaidState({ code: params.value });\n  }\n});\n\nlayoutAndRender();\nbootMcpApp('Mermaid Live Diagram Viewer', 360);\n</script>\n</body>\n</html>",
            "allowedTools": ["export_mermaid_svg"],
            "data": {
              "paths": {
                "mermaid": "/mermaid"
              }
            }
          },
          {
            "id": "mermaid_selected_text",
            "component": "Text",
            "text": {
              "@call": "formatString",
              "args": {
                "value": "Selected diagram node in host DataModel: ${/mermaid/selectedNode}"
              }
            }
          }
        ]
      }
    }
  ]
}
