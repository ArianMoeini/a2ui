{
  "name": "MCP App PDF viewer",
  "description": "Interactive multi-page PDF document viewer MCP App with search highlighting, zoom controls, and passage citation extraction.",
  "messages": [
    {
      "version": "v1.0",
      "createSurface": {
        "surfaceId": "gallery-mcp-app-pdf-viewer",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/mcp/catalog.json"
      }
    },
    {
      "version": "v1.0",
      "updateDataModel": {
        "surfaceId": "gallery-mcp-app-pdf-viewer",
        "value": {
          "pdf": {
            "page": 1,
            "searchQuery": "sandbox",
            "citation": "[p.1] Double-iframe sandboxing prevents DOM, cookie, and storage access while keeping DevTools inspection clean."
          }
        }
      }
    },
    {
      "version": "v1.0",
      "updateComponents": {
        "surfaceId": "gallery-mcp-app-pdf-viewer",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": ["pdf_heading", "pdf_search_input", "pdf_app", "pdf_citation_text"],
            "align": "stretch"
          },
          {
            "id": "pdf_heading",
            "component": "Text",
            "text": "### Interactive PDF Document Viewer (`ext-apps/pdf-server` — multi-page navigation, zoom, search highlight & citations)"
          },
          {
            "id": "pdf_search_input",
            "component": "TextField",
            "label": "Highlight text inside PDF document",
            "placeholder": "sandbox",
            "value": {
              "@path": "/pdf/searchQuery"
            }
          },
          {
            "id": "pdf_app",
            "component": "McpApp",
            "title": "PDF Document Viewer",
            "htmlContent": "<!doctype html>\n<html>\n<head>\n<meta charset=\"utf-8\" />\n<style>\n\n* { box-sizing: border-box; }\nbody {\n  margin: 0;\n  font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n  background: #0f172a;\n  color: #e2e8f0;\n  height: 100vh;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n.topbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  padding: 8px 12px;\n  background: #1e293b;\n  border-bottom: 1px solid #334155;\n  flex-shrink: 0;\n  flex-wrap: wrap;\n}\n.topbar-left {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.app-badge {\n  font-size: 11px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  padding: 2px 7px;\n  border-radius: 999px;\n  background: rgba(56, 189, 248, 0.16);\n  color: #38bdf8;\n  border: 1px solid rgba(56, 189, 248, 0.3);\n}\n.app-title {\n  font-size: 13px;\n  font-weight: 600;\n  color: #f8fafc;\n}\n.topbar-right {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n.dims-pill {\n  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n  font-size: 11px;\n  padding: 2px 8px;\n  border-radius: 6px;\n  background: #0f172a;\n  color: #94a3b8;\n  border: 1px solid #334155;\n}\n.btn {\n  font-family: inherit;\n  font-size: 11px;\n  font-weight: 500;\n  padding: 4px 9px;\n  border-radius: 6px;\n  border: 1px solid #475569;\n  background: #1e293b;\n  color: #e2e8f0;\n  cursor: pointer;\n  transition: all 120ms ease;\n}\n.btn:hover { background: #334155; color: #fff; }\n.btn.active, .btn.primary {\n  background: #2563eb;\n  border-color: #3b82f6;\n  color: #fff;\n}\n.btn.primary:hover { background: #1d4ed8; }\n\n.pdf-layout {\n  display: grid;\n  grid-template-columns: 130px 1fr;\n  flex: 1;\n  min-height: 0;\n  background: #334155;\n}\n@media (max-width: 560px) {\n  .pdf-layout { grid-template-columns: 1fr; }\n  .thumb-rail { display: none; }\n}\n.thumb-rail {\n  background: #1e293b;\n  border-right: 1px solid #475569;\n  padding: 10px;\n  overflow-y: auto;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n.thumb-item {\n  background: #f8fafc;\n  color: #0f172a;\n  border-radius: 6px;\n  padding: 8px;\n  font-size: 10px;\n  cursor: pointer;\n  border: 2px solid transparent;\n}\n.thumb-item.active { border-color: #38bdf8; box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.25); }\n.thumb-num { font-weight: 700; color: #475569; margin-bottom: 3px; }\n.page-stage {\n  flex: 1;\n  overflow: auto;\n  padding: 16px;\n  display: flex;\n  justify-content: center;\n  align-items: flex-start;\n}\n.pdf-page {\n  background: #ffffff;\n  color: #0f172a;\n  width: 520px;\n  min-height: 300px;\n  border-radius: 4px;\n  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.45);\n  padding: 24px 28px;\n  transform-origin: top center;\n  transition: transform 120ms ease;\n}\n.page-hdr {\n  display: flex;\n  justify-content: space-between;\n  font-size: 10px;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n  color: #64748b;\n  border-bottom: 1px solid #e2e8f0;\n  padding-bottom: 6px;\n  margin-bottom: 12px;\n}\n.page-h1 { font-size: 16px; font-weight: 800; color: #0f172a; margin: 0 0 8px; }\n.page-p { font-size: 12.5px; line-height: 1.6; color: #334155; margin: 0 0 10px; }\n.cite-callout {\n  background: #eff6ff;\n  border-left: 3px solid #2563eb;\n  padding: 8px 10px;\n  font-size: 12px;\n  color: #1e3a8a;\n  border-radius: 4px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 8px;\n}\nmark { background: #fef08a; color: #0f172a; padding: 0 2px; border-radius: 2px; }\n</style>\n</head>\n<body>\n  <div class=\"topbar\">\n    <div class=\"topbar-left\">\n      <span class=\"app-badge\">MCP App 6</span>\n      <span class=\"app-title\">PDF Document Viewer</span>\n      <button class=\"btn\" id=\"prev-page\">◀</button>\n      <span style=\"font-size:12px;font-weight:600;\" id=\"page-indicator\">Page 1 / 3</span>\n      <button class=\"btn\" id=\"next-page\">▶</button>\n    </div>\n    <div class=\"topbar-right\">\n      <button class=\"btn\" id=\"zoom-out\">−</button>\n      <span style=\"font-size:11px;\" id=\"zoom-label\">100%</span>\n      <button class=\"btn\" id=\"zoom-in\">+</button>\n      <span class=\"dims-pill\" id=\"dims-badge\">auto</span>\n    </div>\n  </div>\n  <div class=\"pdf-layout\">\n    <div class=\"thumb-rail\" id=\"thumb-rail\"></div>\n    <div class=\"page-stage\">\n      <div class=\"pdf-page\" id=\"pdf-page\"></div>\n    </div>\n  </div>\n<script>\n\nlet nextId = 1;\nconst pending = new Map();\nlet hostDims = { width: 0, height: 0 };\nconst toolInputListeners = [];\nconst toolResultListeners = [];\nconst dataUpdateListeners = [];\nconst hostContextListeners = [];\n\nfunction post(message) {\n  window.parent.postMessage(message, '*');\n}\n\nfunction sendRequest(method, params) {\n  const id = nextId++;\n  post({ jsonrpc: '2.0', id, method, params });\n  return new Promise((resolve, reject) => pending.set(id, { resolve, reject }));\n}\n\nfunction sendNotification(method, params = {}) {\n  post({ jsonrpc: '2.0', method, params });\n}\n\nfunction reportSize(height, width) {\n  const params = {};\n  if (typeof height === 'number') params.height = Math.round(height);\n  if (typeof width === 'number') params.width = Math.round(width);\n  sendNotification('ui/notifications/size-changed', params);\n}\n\nfunction updateDimsBadge(dims) {\n  if (!dims) return;\n  if (typeof dims.width === 'number') hostDims.width = Math.round(dims.width);\n  if (typeof dims.height === 'number') hostDims.height = Math.round(dims.height);\n  const el = document.getElementById('dims-badge');\n  if (el && hostDims.width && hostDims.height) {\n    el.textContent = hostDims.width + ' × ' + hostDims.height + ' px';\n  }\n}\n\nwindow.addEventListener('message', (event) => {\n  const msg = event.data;\n  if (!msg || msg.jsonrpc !== '2.0') return;\n  if (msg.method === 'ping' && msg.id !== undefined) {\n    post({ jsonrpc: '2.0', id: msg.id, result: {} });\n    return;\n  }\n  if (msg.id !== undefined && (msg.result !== undefined || msg.error !== undefined)) {\n    const waiter = pending.get(msg.id);\n    if (waiter) {\n      pending.delete(msg.id);\n      if (msg.error) waiter.reject(msg.error);\n      else waiter.resolve(msg.result);\n    }\n    return;\n  }\n  if (msg.method === 'ui/notifications/tool-input') {\n    const args = (msg.params && msg.params.arguments) || {};\n    toolInputListeners.forEach((fn) => fn(args));\n  } else if (msg.method === 'ui/notifications/tool-result') {\n    const res = msg.params || {};\n    toolResultListeners.forEach((fn) => fn(res));\n  } else if (msg.method === 'ui/notifications/data-model-update') {\n    dataUpdateListeners.forEach((fn) => fn(msg.params || {}));\n  } else if (msg.method === 'ui/notifications/host-context-changed') {\n    const ctx = msg.params || {};\n    if (ctx.containerDimensions) updateDimsBadge(ctx.containerDimensions);\n    hostContextListeners.forEach((fn) => fn(ctx));\n  }\n});\n\nasync function bootMcpApp(appName, initialHeight) {\n  const initResult = await sendRequest('ui/initialize', {\n    appInfo: { name: appName, version: '1.0.0' },\n    appCapabilities: { availableDisplayModes: ['inline', 'fullscreen'] },\n    protocolVersion: '2026-01-26',\n  });\n  if (initResult && initResult.hostContext && initResult.hostContext.containerDimensions) {\n    updateDimsBadge(initResult.hostContext.containerDimensions);\n  }\n  sendNotification('ui/notifications/initialized', {});\n  if (initialHeight) {\n    reportSize(initialHeight);\n  }\n}\n\n\nconst PAGES = [\n  {\n    num: 1,\n    section: 'Section 1 • Double-Iframe Isolation',\n    title: 'A2UI v1.0 Sandboxed MCP Apps Architecture',\n    paragraphs: [\n      'A2UI isolates third-party Model Context Protocol (MCP) views inside a double-iframe sandbox. The outer proxy frame verifies origin and referrer headers while the inner frame executes with sandbox=\"allow-scripts\" and an opaque null origin.',\n      'All network requests (fetch, XHR, WebSocket) are blocked by the injected Content-Security-Policy, ensuring every tool invocation and state mutation flows strictly through the JSON-RPC 2.0 AppBridge.'\n    ],\n    quote: 'Double-iframe sandboxing prevents DOM, cookie, and storage access while keeping DevTools inspection clean.'\n  },\n  {\n    num: 2,\n    section: 'Section 2 • Standard Protocol & Data Binding',\n    title: 'Bridging A2UI DataModel with MCP ext-apps',\n    paragraphs: [\n      'When an MCP App finishes ui/notifications/initialized, McpAppBridge automatically dispatches both A2UI data-model-update notifications and standard MCP ui/notifications/tool-input and tool-result payloads.',\n      'Views built with @modelcontextprotocol/ext-apps work out of the box alongside native A2UI TextFields, Sliders, and ChoicePickers with zero agent round-trips.'\n    ],\n    quote: 'McpAppBridge unifies two-way A2UI JSON Pointer bindings with standard MCP Apps tool-input and tool-result streams.'\n  },\n  {\n    num: 3,\n    section: 'Section 3 • Dynamic & Manual Container Sizing',\n    title: 'Responsive Container Dimensions & Guardrails',\n    paragraphs: [\n      'Host container dimension changes are observed via ResizeObserver and streamed to the embedded view through ui/notifications/host-context-changed.',\n      'App-initiated size requests via ui/notifications/size-changed are throttled to 100ms and clamped between 100px and 2000px to guarantee host layout stability.'\n    ],\n    quote: 'Drag the bottom or corner handle of any MCP App frame to test real-time host-context-changed container resizing.'\n  }\n];\n\nlet currentPage = 1;\nlet zoomPct = 100;\nlet searchQuery = '';\n\nfunction highlightText(text, query) {\n  const container = document.createDocumentFragment();\n  if (!query) {\n    container.appendChild(document.createTextNode(text));\n    return container;\n  }\n  const parts = text.split(new RegExp(`(${query.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')})`, 'gi'));\n  parts.forEach(part => {\n    if (part.toLowerCase() === query.toLowerCase()) {\n      const m = document.createElement('mark');\n      m.textContent = part;\n      container.appendChild(m);\n    } else {\n      container.appendChild(document.createTextNode(part));\n    }\n  });\n  return container;\n}\n\nfunction renderPdf() {\n  document.getElementById('page-indicator').textContent = `Page ${currentPage} / ${PAGES.length}`;\n  document.getElementById('zoom-label').textContent = zoomPct + '%';\n\n  const rail = document.getElementById('thumb-rail');\n  rail.textContent = '';\n  PAGES.forEach(p => {\n    const item = document.createElement('div');\n    item.className = 'thumb-item' + (p.num === currentPage ? ' active' : '');\n    const num = document.createElement('div');\n    num.className = 'thumb-num';\n    num.textContent = 'PAGE ' + p.num;\n    const t = document.createElement('div');\n    t.textContent = p.title;\n    item.append(num, t);\n    item.addEventListener('click', () => {\n      currentPage = p.num;\n      renderPdf();\n      syncPdfPage();\n    });\n    rail.appendChild(item);\n  });\n\n  const pageEl = document.getElementById('pdf-page');\n  pageEl.style.transform = `scale(${zoomPct / 100})`;\n  pageEl.textContent = '';\n  const p = PAGES[currentPage - 1] || PAGES[0];\n\n  const hdr = document.createElement('div');\n  hdr.className = 'page-hdr';\n  const secSpan = document.createElement('span');\n  secSpan.textContent = p.section;\n  const pgSpan = document.createElement('span');\n  pgSpan.textContent = 'p. ' + p.num;\n  hdr.append(secSpan, pgSpan);\n\n  const h1 = document.createElement('h1');\n  h1.className = 'page-h1';\n  h1.appendChild(highlightText(p.title, searchQuery));\n\n  pageEl.append(hdr, h1);\n  p.paragraphs.forEach(para => {\n    const pEl = document.createElement('p');\n    pEl.className = 'page-p';\n    pEl.appendChild(highlightText(para, searchQuery));\n    pageEl.appendChild(pEl);\n  });\n\n  const callout = document.createElement('div');\n  callout.className = 'cite-callout';\n  const qSpan = document.createElement('span');\n  qSpan.appendChild(highlightText('“' + p.quote + '”', searchQuery));\n  const citeBtn = document.createElement('button');\n  citeBtn.className = 'btn primary';\n  citeBtn.textContent = 'Cite Passage';\n  citeBtn.addEventListener('click', () => {\n    const citation = `[p.${p.num}] ${p.quote}`;\n    sendNotification('ui/notifications/data-model-change', {\n      key: 'toolResult',\n      subpath: '/citation',\n      value: citation,\n    });\n    sendRequest('tools/call', {\n      name: 'cite_pdf_passage',\n      arguments: { page: p.num, quote: p.quote },\n    });\n  });\n  callout.append(qSpan, citeBtn);\n  pageEl.appendChild(callout);\n}\n\nfunction syncPdfPage() {\n  sendNotification('ui/notifications/data-model-change', {\n    key: 'toolResult',\n    subpath: '/page',\n    value: currentPage,\n  });\n}\n\ndocument.getElementById('prev-page').addEventListener('click', () => {\n  currentPage = Math.max(1, currentPage - 1);\n  renderPdf();\n  syncPdfPage();\n});\ndocument.getElementById('next-page').addEventListener('click', () => {\n  currentPage = Math.min(PAGES.length, currentPage + 1);\n  renderPdf();\n  syncPdfPage();\n});\ndocument.getElementById('zoom-in').addEventListener('click', () => {\n  zoomPct = Math.min(130, zoomPct + 10);\n  renderPdf();\n});\ndocument.getElementById('zoom-out').addEventListener('click', () => {\n  zoomPct = Math.max(75, zoomPct - 10);\n  renderPdf();\n});\n\nfunction applyPdfData(d) {\n  if (!d || typeof d !== 'object') return;\n  if (typeof d.searchQuery === 'string') {\n    searchQuery = d.searchQuery.trim();\n    renderPdf();\n  }\n  if (typeof d.page === 'number' && d.page >= 1 && d.page <= PAGES.length) {\n    currentPage = d.page;\n    renderPdf();\n  }\n}\n\ntoolResultListeners.push((res) => {\n  if (res && res.structuredContent) applyPdfData(res.structuredContent);\n});\ndataUpdateListeners.push((params) => {\n  if (params.key === 'toolResult') {\n    if (!params.subpath) applyPdfData(params.value);\n    else if (params.subpath === '/searchQuery') applyPdfData({ searchQuery: String(params.value || '') });\n    else if (params.subpath === '/page') applyPdfData({ page: Number(params.value) });\n  }\n});\n\nrenderPdf();\nbootMcpApp('PDF Document Viewer', 360);\n</script>\n</body>\n</html>",
            "allowedTools": ["cite_pdf_passage"],
            "data": {
              "paths": {
                "toolResult": "/pdf"
              }
            }
          },
          {
            "id": "pdf_citation_text",
            "component": "Text",
            "text": {
              "@call": "formatString",
              "args": {
                "value": "Extracted PDF citation: ${/pdf/citation}"
              }
            }
          }
        ]
      }
    }
  ]
}
