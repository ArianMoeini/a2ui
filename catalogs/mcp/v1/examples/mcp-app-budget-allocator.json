          {
            "id": "budget_heading",
            "component": "Text",
            "text": "### SaaS Budget Allocator & Benchmark Modeler (`apigene/mcp-apps` — `ontoolresult` structuredContent)"
          },
          {
            "id": "budget_app",
            "component": "McpApp",
            "title": "SaaS Budget Allocator",
            "htmlContent": "<!doctype html>\n<html>\n<head>\n<meta charset=\"utf-8\" />\n<style>\n\n* { box-sizing: border-box; }\nbody {\n  margin: 0;\n  font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n  background: #0f172a;\n  color: #e2e8f0;\n  height: 100vh;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n.topbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  padding: 8px 12px;\n  background: #1e293b;\n  border-bottom: 1px solid #334155;\n  flex-shrink: 0;\n  flex-wrap: wrap;\n}\n.topbar-left {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.app-badge {\n  font-size: 11px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  padding: 2px 7px;\n  border-radius: 999px;\n  background: rgba(56, 189, 248, 0.16);\n  color: #38bdf8;\n  border: 1px solid rgba(56, 189, 248, 0.3);\n}\n.app-title {\n  font-size: 13px;\n  font-weight: 600;\n  color: #f8fafc;\n}\n.topbar-right {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n.dims-pill {\n  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n  font-size: 11px;\n  padding: 2px 8px;\n  border-radius: 6px;\n  background: #0f172a;\n  color: #94a3b8;\n  border: 1px solid #334155;\n}\n.btn {\n  font-family: inherit;\n  font-size: 11px;\n  font-weight: 500;\n  padding: 4px 9px;\n  border-radius: 6px;\n  border: 1px solid #475569;\n  background: #1e293b;\n  color: #e2e8f0;\n  cursor: pointer;\n  transition: all 120ms ease;\n}\n.btn:hover { background: #334155; color: #fff; }\n.btn.active, .btn.primary {\n  background: #2563eb;\n  border-color: #3b82f6;\n  color: #fff;\n}\n.btn.primary:hover { background: #1d4ed8; }\n\n.content {\n  display: grid;\n  grid-template-columns: 210px 1fr;\n  gap: 14px;\n  padding: 12px;\n  flex: 1;\n  min-height: 0;\n  overflow: auto;\n}\n@media (max-width: 560px) {\n  .content { grid-template-columns: 1fr; }\n}\n.chart-card {\n  background: #1e293b;\n  border: 1px solid #334155;\n  border-radius: 10px;\n  padding: 12px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n}\n.kpi-value { font-size: 18px; font-weight: 700; color: #f8fafc; margin-top: 6px; }\n.kpi-sub { font-size: 11px; color: #38bdf8; }\n.sliders-card {\n  background: #1e293b;\n  border: 1px solid #334155;\n  border-radius: 10px;\n  padding: 12px;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  justify-content: center;\n}\n.cat-row { display: flex; flex-direction: column; gap: 3px; }\n.cat-header {\n  display: flex;\n  justify-content: space-between;\n  font-size: 12px;\n  font-weight: 600;\n}\n.cat-controls {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\ninput[type=\"range\"] {\n  flex: 1;\n  accent-color: #38bdf8;\n}\n.bench-pill {\n  font-size: 10px;\n  padding: 2px 6px;\n  border-radius: 4px;\n  font-weight: 600;\n  min-width: 82px;\n  text-align: center;\n}\n.bench-ok { background: rgba(34, 197, 94, 0.18); color: #4ade80; }\n.bench-warn { background: rgba(245, 158, 11, 0.18); color: #fbbf24; }\n</style>\n</head>\n<body>\n  <div class=\"topbar\">\n    <div class=\"topbar-left\">\n      <span class=\"app-badge\">MCP App 2</span>\n      <span class=\"app-title\">SaaS Budget Allocator & Benchmarks</span>\n      <button class=\"btn active\" data-stage=\"Seed\">Seed</button>\n      <button class=\"btn\" data-stage=\"Series A\">Series A</button>\n      <button class=\"btn\" data-stage=\"Series B\">Series B</button>\n    </div>\n    <div class=\"topbar-right\">\n      <button class=\"btn primary\" id=\"apply-btn\">Commit Allocation</button>\n      <span class=\"dims-pill\" id=\"dims-badge\">auto</span>\n    </div>\n  </div>\n  <div class=\"content\">\n    <div class=\"chart-card\">\n      <svg id=\"donut\" width=\"150\" height=\"150\" viewBox=\"0 0 42 42\"></svg>\n      <div class=\"kpi-value\" id=\"total-display\">$120,000 / mo</div>\n      <div class=\"kpi-sub\" id=\"runway-display\">Runway: 22.5 mos</div>\n    </div>\n    <div class=\"sliders-card\" id=\"sliders\"></div>\n  </div>\n<script>\n\nlet nextId = 1;\nconst pending = new Map();\nlet hostDims = { width: 0, height: 0 };\nconst toolInputListeners = [];\nconst toolResultListeners = [];\nconst dataUpdateListeners = [];\nconst hostContextListeners = [];\n\nfunction post(message) {\n  window.parent.postMessage(message, '*');\n}\n\nfunction sendRequest(method, params) {\n  const id = nextId++;\n  post({ jsonrpc: '2.0', id, method, params });\n  return new Promise((resolve, reject) => pending.set(id, { resolve, reject }));\n}\n\nfunction sendNotification(method, params = {}) {\n  post({ jsonrpc: '2.0', method, params });\n}\n\nfunction reportSize(height, width) {\n  const params = {};\n  if (typeof height === 'number') params.height = Math.round(height);\n  if (typeof width === 'number') params.width = Math.round(width);\n  sendNotification('ui/notifications/size-changed', params);\n}\n\nfunction updateDimsBadge(dims) {\n  if (!dims) return;\n  if (typeof dims.width === 'number') hostDims.width = Math.round(dims.width);\n  if (typeof dims.height === 'number') hostDims.height = Math.round(dims.height);\n  const el = document.getElementById('dims-badge');\n  if (el && hostDims.width && hostDims.height) {\n    el.textContent = hostDims.width + ' × ' + hostDims.height + ' px';\n  }\n}\n\nwindow.addEventListener('message', (event) => {\n  const msg = event.data;\n  if (!msg || msg.jsonrpc !== '2.0') return;\n  if (msg.method === 'ping' && msg.id !== undefined) {\n    post({ jsonrpc: '2.0', id: msg.id, result: {} });\n    return;\n  }\n  if (msg.id !== undefined && (msg.result !== undefined || msg.error !== undefined)) {\n    const waiter = pending.get(msg.id);\n    if (waiter) {\n      pending.delete(msg.id);\n      if (msg.error) waiter.reject(msg.error);\n      else waiter.resolve(msg.result);\n    }\n    return;\n  }\n  if (msg.method === 'ui/notifications/tool-input') {\n    const args = (msg.params && msg.params.arguments) || {};\n    toolInputListeners.forEach((fn) => fn(args));\n  } else if (msg.method === 'ui/notifications/tool-result') {\n    const res = msg.params || {};\n    toolResultListeners.forEach((fn) => fn(res));\n  } else if (msg.method === 'ui/notifications/data-model-update') {\n    dataUpdateListeners.forEach((fn) => fn(msg.params || {}));\n  } else if (msg.method === 'ui/notifications/host-context-changed') {\n    const ctx = msg.params || {};\n    if (ctx.containerDimensions) updateDimsBadge(ctx.containerDimensions);\n    hostContextListeners.forEach((fn) => fn(ctx));\n  }\n});\n\nasync function bootMcpApp(appName, initialHeight) {\n  const initResult = await sendRequest('ui/initialize', {\n    appInfo: { name: appName, version: '1.0.0' },\n    appCapabilities: { availableDisplayModes: ['inline', 'fullscreen'] },\n    protocolVersion: '2026-01-26',\n  });\n  if (initResult && initResult.hostContext && initResult.hostContext.containerDimensions) {\n    updateDimsBadge(initResult.hostContext.containerDimensions);\n  }\n  sendNotification('ui/notifications/initialized', {});\n  if (initialHeight) {\n    reportSize(initialHeight);\n  }\n}\n\n\nconst BENCHMARKS = {\n  'Seed': { eng: [42, 58], infra: [12, 22], growth: [15, 28], ops: [8, 15] },\n  'Series A': { eng: [35, 48], infra: [10, 20], growth: [25, 38], ops: [10, 18] },\n  'Series B': { eng: [28, 40], infra: [8, 16], growth: [32, 46], ops: [12, 20] },\n};\n\nconst CATEGORIES = [\n  { key: 'eng', label: 'Engineering & R&D', color: '#38bdf8' },\n  { key: 'infra', label: 'AI Compute & Cloud', color: '#818cf8' },\n  { key: 'growth', label: 'Growth & GTM', color: '#34d399' },\n  { key: 'ops', label: 'Operations & G&A', color: '#fbbf24' },\n];\n\nlet state = {\n  stage: 'Seed',\n  monthlyBudget: 120000,\n  cashReserve: 2700000,\n  allocations: { eng: 48, infra: 18, growth: 22, ops: 12 },\n};\n\nfunction renderBudget() {\n  const totalPct = Object.values(state.allocations).reduce((a, b) => a + b, 0) || 1;\n  const donut = document.getElementById('donut');\n  donut.textContent = '';\n  const ns = 'http://www.w3.org/2000/svg';\n  let offset = 25;\n  for (const cat of CATEGORIES) {\n    const pct = (state.allocations[cat.key] / totalPct) * 100;\n    const circle = document.createElementNS(ns, 'circle');\n    circle.setAttribute('cx', '21');\n    circle.setAttribute('cy', '21');\n    circle.setAttribute('r', '15.9155');\n    circle.setAttribute('fill', 'transparent');\n    circle.setAttribute('stroke', cat.color);\n    circle.setAttribute('stroke-width', '5.5');\n    circle.setAttribute('stroke-dasharray', `${pct} ${100 - pct}`);\n    circle.setAttribute('stroke-dashoffset', String(offset));\n    donut.appendChild(circle);\n    offset -= pct;\n  }\n\n  const effectiveBurn = state.monthlyBudget * (totalPct / 100);\n  const runway = (state.cashReserve / Math.max(effectiveBurn, 1)).toFixed(1);\n  document.getElementById('total-display').textContent = '$' + Math.round(effectiveBurn).toLocaleString('en-US') + ' / mo';\n  document.getElementById('runway-display').textContent = `${state.stage} • Runway: ${runway} mos`;\n\n  const sliders = document.getElementById('sliders');\n  sliders.textContent = '';\n  const bench = BENCHMARKS[state.stage] || BENCHMARKS['Seed'];\n  let inBandCount = 0;\n\n  for (const cat of CATEGORIES) {\n    const val = state.allocations[cat.key];\n    const [p25, p75] = bench[cat.key];\n    const inBand = val >= p25 && val <= p75;\n    if (inBand) inBandCount++;\n    const dollars = Math.round((state.monthlyBudget * val) / 100);\n\n    const row = document.createElement('div');\n    row.className = 'cat-row';\n    const header = document.createElement('div');\n    header.className = 'cat-header';\n    const titleSpan = document.createElement('span');\n    titleSpan.style.color = cat.color;\n    titleSpan.textContent = cat.label;\n    const valSpan = document.createElement('span');\n    valSpan.textContent = `${val}% ($${dollars.toLocaleString('en-US')})`;\n    header.append(titleSpan, valSpan);\n\n    const controls = document.createElement('div');\n    controls.className = 'cat-controls';\n    const input = document.createElement('input');\n    input.type = 'range';\n    input.min = '5';\n    input.max = '70';\n    input.value = String(val);\n    input.addEventListener('input', () => {\n      state.allocations[cat.key] = Number(input.value);\n      renderBudget();\n      syncSummary();\n    });\n    const pill = document.createElement('span');\n    pill.className = 'bench-pill ' + (inBand ? 'bench-ok' : 'bench-warn');\n    pill.textContent = inBand ? `P25-P75 (${p25}-${p75}%)` : (val < p25 ? `Below P25 (<${p25}%)` : `Above P75 (>${p75}%)`);\n    controls.append(input, pill);\n    row.append(header, controls);\n    sliders.appendChild(row);\n  }\n}\n\nfunction syncSummary() {\n  const totalPct = Object.values(state.allocations).reduce((a, b) => a + b, 0) || 1;\n  const effectiveBurn = Math.round(state.monthlyBudget * (totalPct / 100));\n  const runway = (state.cashReserve / Math.max(effectiveBurn, 1)).toFixed(1);\n  const summary = `${state.stage}: $${effectiveBurn.toLocaleString('en-US')}/mo burn (${runway} mos runway)`;\n  if (summary === state.summary) return;\n  state.summary = summary;\n  sendNotification('ui/notifications/data-model-change', {\n    key: 'toolResult',\n    subpath: '/summary',\n    value: summary,\n  });\n}\n\ndocument.querySelectorAll('[data-stage]').forEach(btn => {\n  btn.addEventListener('click', () => {\n    document.querySelectorAll('[data-stage]').forEach(b => b.classList.remove('active'));\n    btn.classList.add('active');\n    state.stage = btn.getAttribute('data-stage');\n    renderBudget();\n    syncSummary();\n  });\n});\n\ndocument.getElementById('apply-btn').addEventListener('click', () => {\n  sendRequest('tools/call', {\n    name: 'apply_budget_scenario',\n    arguments: { stage: state.stage, monthlyBudget: state.monthlyBudget, allocations: state.allocations },\n  });\n});\n\nfunction applyIncomingBudget(data) {\n  if (!data || typeof data !== 'object') return;\n  if (typeof data.monthlyBudget === 'number' && data.monthlyBudget > 0) state.monthlyBudget = data.monthlyBudget;\n  if (typeof data.stage === 'string') state.stage = data.stage;\n  if (typeof data.summary === 'string') state.summary = data.summary;\n  if (data.allocations && typeof data.allocations === 'object') {\n    state.allocations = { ...state.allocations, ...data.allocations };\n  }\n  renderBudget();\n  syncSummary();\n}\n\ntoolResultListeners.push((res) => {\n  if (res && res.structuredContent) applyIncomingBudget(res.structuredContent);\n});\ndataUpdateListeners.push((params) => {\n  if (params.key === 'toolResult') {\n    if (!params.subpath) applyIncomingBudget(params.value);\n    else if (params.subpath === '/monthlyBudget') applyIncomingBudget({ monthlyBudget: Number(params.value) });\n    else if (params.subpath === '/stage') applyIncomingBudget({ stage: String(params.value) });\n  }\n});\n\nrenderBudget();\nbootMcpApp('SaaS Budget Allocator', 310);\n</script>\n</body>\n</html>",
            "allowedTools": ["apply_budget_scenario"],
            "data": {
              "paths": {
                "toolResult": "/budget"
              }
            }
          },
          {
            "id": "budget_summary_text",
            "component": "Text",
            "text": {
              "@call": "formatString",
              "args": {
                "value": "Live budget scenario summary: ${/budget/summary}"
              }
            }
          }
        ]
      }
    }
  ]
}
